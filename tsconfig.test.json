{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The tests and the build's own configuration. Separate from `tsconfig.json` because this half
  // runs in Node — it reads the contacts kit off disk and installs the host global — and the module
  // itself must never see a `node` type.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  // `src/jsx.d.ts` is listed because a test that renders the panel pulls `src/Panel.tsx` into
  // *this* project, and the classic JSX transform resolves elements through that global namespace.
  "include": ["test/**/*.ts", "src/jsx.d.ts", "vitest.config.ts", "rollup.config.mjs"]
}
